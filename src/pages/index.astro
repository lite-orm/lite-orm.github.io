---
import '../styles/site.css';

const features = [
  ['Compile-time first', 'SQL, parameters, and result shapes are checked before runtime.'],
  ['Explicit JDBC', 'Generated Mappers call one small executor contract.'],
  ['Spring-ready', 'DataSource domains and transactions stay under Spring ownership.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Compile-time SQL mapping for explicit Java and JDBC systems." />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <title>lite-orm — Compile-time SQL mapping</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><span aria-hidden="true">⚡</span> lite-orm</a>
      <nav><a href="/docs">Docs</a><a href="/docs/user/spring/spring-boot">Spring Boot</a><a href="https://github.com/lite-orm/lite-orm" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
    </header>
    <main>
      <section class="hero">
        <div class="hero-copy">
          <div class="stack-tags" aria-label="LiteORM technology stack"><span>JAVA</span><i>+</i><span>JDBC</span><i>+</i><span>COMPILE-TIME</span></div>
          <h1>lite-orm</h1>
          <p class="slogan">SQL mapping, made visible.</p>
          <p class="lede">Generate readable Java Mappers at compile time, then execute them through one explicit JDBC lifecycle—from connection to cleanup.</p>
          <div class="actions"><a class="button primary" href="/docs/user/getting-started/">Quick Start</a><a class="button ghost" href="https://github.com/lite-orm/lite-orm" target="_blank" rel="noopener noreferrer">View on GitHub</a></div>
        </div>
        <div class="signal-card" aria-label="LiteORM compile-time signal">
          <div class="signal-glow"></div><div class="signal-orbit orbit-one"></div><div class="signal-orbit orbit-two"></div>
          <div class="signal-core"><span>⚡</span><small>lite-orm</small></div>
          <div class="signal-chip chip-top">COMPILE-TIME <b>✓</b></div><div class="signal-chip chip-right">Mapper.java</div><div class="signal-chip chip-bottom">JDBC lifecycle</div>
          <div class="signal-lines"><span></span><span></span><span></span></div>
        </div>
      </section>
      <section class="features"><p class="eyebrow">A SMALLER SURFACE AREA</p><h2>Make the SQL path obvious.</h2><div class="feature-grid">{features.map(([title, text], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
      <section class="comparison"><div><p class="eyebrow">SEE THE DIFFERENCE</p><h2>Generated code. Visible execution.</h2><p>LiteORM moves stable mapping decisions to compile time and leaves connection, statement, mapping, and cleanup behavior explicit at runtime.</p><a href="/docs">Explore the architecture →</a></div><img src="/assets/liteorm-vs-mybatis-flow-en.gif" alt="LiteORM and MyBatis execution flow comparison" /></section>
    </main>
    <footer><span>⚡ lite-orm</span><span>Apache-2.0 · Built for explicit Java systems</span></footer>
  </body>
</html>
